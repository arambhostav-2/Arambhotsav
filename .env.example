# Email (Resend)
RESEND_API_KEY=
RESEND_FROM=Garba Nights <tickets@example.com>

# Admin (email restriction) — only this email can access /admin
NEXT_PUBLIC_ADMIN_EMAIL=balamallikarjunadatta08@gmail.com
ADMIN_EMAIL=balamallikarjunadatta08@gmail.com
ADMIN_PASSWORD=garba-admin-123
ADMIN_KEY=garba-admin-123

# UPI (zero-fee payments) — your UPI VPA, e.g. yourname@okhdfcbank / yourname@upi
NEXT_PUBLIC_UPI_ID=yourname@upi
NEXT_PUBLIC_UPI_NAME=Garba Nights

# Admin notifications (Resend email) — get alerted on new/confirmed UPI payments
# Set RESEND_API_KEY + ADMIN_NOTIFY_EMAIL to your Resend account & inbox.
RESEND_API_KEY=
RESEND_FROM=Garba Nights <tickets@example.com>
ADMIN_NOTIFY_EMAIL=

